# Copy to .env and set locally. Never commit credentials.
CRASHCART_DB=var/crashcart.sqlite3
CRASHCART_HOST=127.0.0.1
CRASHCART_PORT=8765
CRASHCART_PUBLIC_URL=http://127.0.0.1:8765
# Required for operator API and browser access. Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(32))'
CRASHCART_OPERATOR_TOKEN=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# Provider is explicit: openai uses Responses; modal uses the owned Chat Completions endpoint.
CRASHCART_MODEL_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
# Configure privately only after runtime usage is authorized. No credential fallback.
MODAL_API_KEY=
MODAL_MODEL=deepseek-ai/DeepSeek-V4.1-Flash
# Pin your owned deployment explicitly. Both values must be the identical
# canonical https://<deployment>.modal.run origin, without path or trailing slash.
MODAL_ALLOWED_ORIGIN=
MODAL_BASE_URL=
KERNEL_API_KEY=
AG_STUDIO_LICENSE_KEY=
# Provider calls must be deliberately enabled after configuration.
CRASHCART_ALLOW_SANDBOX=0
CRASHCART_ALLOW_MODEL=0
# Separate held-out process only; requires independently reviewed immutable policy.
# These settings do not grant model or sandbox usage. See docs/held-out-protocol.md.
CRASHCART_EVALUATION_MODE=ordinary
CRASHCART_HELD_OUT_POLICY=
CRASHCART_HELD_OUT_POLICY_SHA256=
# Explicit lifetime call allowance for Studio queries in this database (1..16).
# Keep zero until the account owner authorizes the chosen model and usage.
CRASHCART_STUDIO_MODEL_MAX_CALLS=0
CRASHCART_ALLOW_KERNEL=0
CRASHCART_ALLOW_PROCESS_INTERRUPT=0

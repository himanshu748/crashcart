                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Registered fixture responds HTTP 200\", () => pm.response.to.have.status(200));",
                    "const body = pm.response.json();",
                    "pm.test(\"Owned workshop fixture identity is fixed\", () => pm.expect(body.id).to.eql(\"workshop-v1\"));",

                "type": "noauth",
                "noauth": []
              }
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "9731d224-9004-4616-a82d-ae2e4868a7b1",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Health responds HTTP 200\", () => pm.response.to.have.status(200));",
                    "const body = pm.response.json();",
                    "pm.test(\"Application identifies CrashCart\", () => pm.expect(body.service).to.eql(\"crashcart\"));",
                    "pm.test(\"API and actual database are healthy\", () => {pm.expect(body.status).to.eql(\"ok\"); pm.expect(body.database).to.eql(\"ok\");});"
                  ],
                  "_lastExecutionId": "627b0542-d15d-4501-8734-5a94ef7f6f66"
                }
              }
            ]
          },
          {
            "id": "a9199e4f-e34b-47e7-84b7-ccc53bb8fdfc",

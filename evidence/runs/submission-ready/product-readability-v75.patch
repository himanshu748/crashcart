wrap;overflow-wrap:anywhere;font-family:ui-monospace,SFMono-Regular,Menlo,monospace;font-size:11px;line-height:1.7;margin:0;background:#eff1e8;padding:18px;border-radius:4px;max-height:320px;overflow:auto}.technical{border:1px solid var(--line);padding:0 16px;border-radius:5px;font-size:12px}.technical p{margin:0 12px 14px}.technical pre{margin:0 0 16px}.reproduce{display:grid;grid-template-columns:1fr 1.2fr;gap:50px;padding:45px;background:#e9eddf;border:1px solid #d8dfc9;border-radius:6px;margin-top:65px}.reproduce p{font-size:14px;color:#5b6650;max-width:360px}.reproduce h2{font-size:34px}.commands pre{background:#f6f7f1;margin:16px 0 20px;padding:22px;font-size:12px;max-height:none}.limits{padding:38px 0 45px}.limits h2{font-size:21px;letter-spacing:-.6px}.limits p{font-size:13px;color:var(--muted);max-width:900px}footer{border-top:1px solid var(--line);padding:30px max(4vw,24px);display:flex;gap:24px;align-items:center;justify-content:space-between}footer p,footer>span{font-size:11px;color:var(--muted)}footer .brand{font-size:21px}.notice{padding:20px;border:1px solid var(--line);background:#edf0e3;margin:20px 0}.notice.error{background:#f6eae2;color:#703f2a}[hidden]{display:none!important}
